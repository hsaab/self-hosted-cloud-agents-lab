# Cursor Self-Hosted Pool
CURSOR_API_KEY=replace-with-service-account-api-key
CURSOR_WORKER_POOL_NAME=lab
CURSOR_WORKER_IDLE_RELEASE_TIMEOUT=600
CURSOR_WORKER_LABELS_FILE=/etc/cursor/labels.json
CURSOR_WORKER_MANAGEMENT_ADDR=0.0.0.0:8080
WORKER_ENVIRONMENT_LABEL=lab
WORKER_OWNER_LABEL=local-experiment

# Docker image
WORKER_IMAGE=cursor-self-hosted-worker:local
WORKER_IMAGE_TAG=latest
WORKER_PLATFORM=linux/amd64
# Defaults to the local git remote origin when empty.
WORKER_REPOSITORY_URL=

# Kubernetes
K8S_NAMESPACE=cursord
K8S_WORKER_IMAGE=cursor-self-hosted-worker:local
# helm/labels.json sets infrastructure=eks and runtime=kubernetes.
K8S_WORKER_LABELS_FILE=helm/labels.json
K8S_WORKER_LABELS_CONFIG_MAP=cursor-worker-labels
WORKER_DEPLOYMENT_NAME=my-workers
WORKER_READY_REPLICAS=1
CURSOR_API_KEY_SECRET_NAME=my-workers-api-key
CURSOR_CONTROLLER_RELEASE_NAME=worker-set-controller
CURSOR_CONTROLLER_CHART=oci://public.ecr.aws/j6w0t2f5/cursor/worker-set-controller-chart
CURSOR_CONTROLLER_CHART_VERSION=0.1.0-6c804a0

# AWS shared defaults
AWS_PROFILE=default
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REPOSITORY_NAME=cursor-self-hosted-worker

# EKS approach
EKS_CLUSTER_NAME=cursor-agents-lab

# EC2 approach
EC2_INSTANCE_TYPE=t3.small
EC2_WORKER_HOST_NAME=cursor-worker-lab
EC2_WORKER_INFRASTRUCTURE_LABEL=ec2

# ECS approach
ECS_CLUSTER_NAME=cursor-agents-lab
ECS_SERVICE_NAME=cursor-worker-service
ECS_TASK_FAMILY=cursor-self-hosted-worker
ECS_WORKER_POOL_NAME=ecs-lab
ECS_WORKER_INFRASTRUCTURE_LABEL=ecs
ECS_TASK_CPU=1024
ECS_TASK_MEMORY=2048
ECS_TASK_CPU_ARCHITECTURE=X86_64
ECS_WORKER_LOG_GROUP_NAME=/ecs/cursor-worker-service
ECS_MIN_CAPACITY=1
ECS_MAX_CAPACITY=10
ECS_TARGET_UTILIZATION_PERCENT=75
ECS_SCALE_OUT_COOLDOWN_SECONDS=60
ECS_SCALE_IN_COOLDOWN_SECONDS=900
ECS_ASSIGN_PUBLIC_IP=true
ECS_METRICS_NAMESPACE=Cursor/SelfHostedWorkers
ECS_METRICS_PUBLISHER_NAME=cursor-worker-service-metrics-publisher
